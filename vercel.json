{
  "routes": [
    {
      "src": "^/(?:private|server|tests)(?:/.*)?$",
      "status": 404
    },
    {
      "src": "^/(?:server\\.js|playwright\\.config\\.cjs|package(?:-lock)?\\.json)$",
      "status": 404
    },
    {
      "src": "^/admin/?$",
      "status": 308,
      "headers": {
        "Location": "/admin.html",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/admin\\.html$",
      "dest": "/api/admin"
    },
    {
      "handle": "filesystem"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "public"
}
