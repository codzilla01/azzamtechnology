{
  "routes": [
    {
      "src": "^/(?:private|server|supabase|tests|scripts)(?:/.*)?$",
      "status": 404
    },
    {
      "src": "^/(?:server\\.js|playwright\\.config\\.cjs|package(?:-lock)?\\.json)$",
      "status": 404
    },
    {
      "src": "^/admin/?$",
      "status": 308,
      "headers": {
        "Location": "/admin.html",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/admin\\.html$",
      "dest": "/api/admin"
    },
    {
      "src": "^/api/admin/(data|products|coupons|orders|settings|chatbot|import|reset)$",
      "dest": "/api/admin-data?resource=$1"
    },
    {
      "src": "^/api/coupons/validate$",
      "dest": "/api/coupons"
    },
    {
      "handle": "filesystem"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "public"
}
