# Supabase connection (required in production / Vercel)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin passcode (required in production / Vercel; minimum 6 characters)
AZZAM_ADMIN_PASSCODE=change-this-to-a-strong-passcode

# Optional settings
# AZZAM_SESSION_HOURS=24
# AZZAM_TRUST_PROXY=1
# HOST=127.0.0.1
# PORT=8000
